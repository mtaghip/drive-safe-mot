# Public address of the site, used in the sitemap and share previews. (Set automatically on Vercel.)
SITE_URL=https://www.example.co.uk

# Postgres connection string. Required in production. Without it, development uses an
# embedded Postgres (PGlite) that keeps its data in .data/pglite.
DATABASE_URL=postgres://user:password@localhost:5432/drivesafe

# Setup password for the staff pages: needed once, to create the owner account at /admin/login.
# After that everyone signs in with their own email and password. At least 10 characters.
ADMIN_PASSWORD=

# DVLA Vehicle Enquiry Service key, for the number plate "Look up" button (free:
# https://register-for-ves.driver-vehicle-licensing.api.gov.uk/). Optional.
DVLA_VES_API_KEY=

# Resend (https://resend.com) API key for confirmation emails. Without it, emails are logged to the console.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
BOOKING_FROM_EMAIL="Drive Safe MOT Centre <bookings@example.com>"
# Where new-booking notifications go. Defaults to drivesafeltd@outlook.com.
GARAGE_EMAIL=

# Secret the scheduler sends to /api/cron/daily-schedule (the 8:30am diary email). Any long random string.
# Vercel Cron sends it automatically when set. Without it, the daily email is switched off.
CRON_SECRET=

# Cloudflare Turnstile spam check (https://dash.cloudflare.com → Turnstile). Leave both empty to turn it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
